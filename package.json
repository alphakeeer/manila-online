{
  "name": "manila",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@manila/web",
    "dev:server": "npm run dev --workspace=@manila/server",
    "build": "npm run build --workspace=@manila/web",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "simulate": "tsx scripts/simulate.ts",
    "db:migrate": "npm run migrate --workspace=@manila/server",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "tokens": "npm run tokens --workspace=@manila/server",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@playwright/test": "1.63.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
