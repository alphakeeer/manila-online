# scripts/deploy.sh copies this to .env.production and fills the secrets for you.
# Manual alternative: copy, replace every placeholder, chmod 600. Never commit the real file.

# Public HTTPS origin served by Caddy (no trailing slash).
MANILA_DOMAIN=manila.example.com
ALLOWED_ORIGINS=https://manila.example.com

# Database credentials. Use a long random password and percent-encode reserved URL characters.
POSTGRES_USER=manila
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=manila

# 32+ random bytes, base64/hex. This pepper must be backed up separately.
AUTH_PEPPER=replace-with-a-long-random-secret

# Optional runtime tuning.
MANILA_IMAGE_TAG=local
SESSION_TTL_MS=604800000
LOBBY_IDLE_TIMEOUT_MS=86400000
LOG_LEVEL=info
# Seat takeover: grace before an offline player's turn is played by the bot, and the bot's pause per move.
AUTOPILOT_AWAY_MS=30000
AUTOPILOT_THINK_MS=1500
